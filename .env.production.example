# Copy to .env.production on the deployment host. Do not commit .env.production.
POSTGRES_DB=vinfast_booking
POSTGRES_USER=vinfast
POSTGRES_PASSWORD=replace-with-a-long-random-secret

# Application and provider credentials
OPENROUTER_API_KEY=
ZALO_BOT_TOKEN=
# Generate once with a password manager or `openssl rand -hex 32`; never commit it.
BOOKING_ACCESS_OTP_SECRET=replace-with-a-long-random-secret-at-least-32-characters
BOOKING_ACCESS_EXPOSE_MOCK_OTP=false
ZALO_BOT_ENABLED=false
ZALO_BOT_POLLING_ENABLED=false

# Public API and booking-access rate limits
RATE_LIMIT_CHAT_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_SESSION_PER_HOUR=120
RATE_LIMIT_CHAT_PER_IP_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_IP_PER_HOUR=600
RATE_LIMIT_DEMO_ACTION_PER_SESSION_PER_MINUTE=30
RATE_LIMIT_DEMO_ACTION_PER_SESSION_PER_HOUR=300
RATE_LIMIT_DEMO_ACTION_PER_IP_PER_MINUTE=120
RATE_LIMIT_DEMO_ACTION_PER_IP_PER_HOUR=1200
RATE_LIMIT_OTP_REQUEST_PER_CONTACT_PER_HOUR=10
RATE_LIMIT_OTP_VERIFY_PER_CHALLENGE_PER_MINUTE=5
BOOKING_ACCESS_OTP_RESEND_COOLDOWN_SECONDS=60

# Use immutable tags created by CI for a production deployment.
BACKEND_IMAGE=vinfast-backend:prod
FRONTEND_IMAGE=vinfast-frontend:prod
