# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM Models Configuration
MODEL_NAME=openai/gpt-4o-mini
CLASSIFIER_MODEL_NAME=google/gemini-2.0-flash-exp

# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Zalo Bot (booking access OTP) ----
# Keep these backend-only. Never expose them through Vite or NEXT_PUBLIC_* variables.
# BOT_TOKEN is issued by Zalo Bot Creator and is used for sendMessage calls.
ZALO_BOT_TOKEN=your-zalo-bot-token-here
# Must exactly match the secret_token configured while registering the Zalo webhook.
ZALO_BOT_WEBHOOK_SECRET=replace-with-a-long-random-secret
ZALO_BOT_API_BASE_URL=https://bot-api.zaloplatforms.com
# Enable only after the webhook and the Zalo identity-link flow are deployed.
ZALO_BOT_ENABLED=false
# Local/demo only: continuously reads Bot messages with getUpdates. Do not enable
# together with a configured Zalo webhook.
ZALO_BOT_POLLING_ENABLED=false
ZALO_BOT_POLL_TIMEOUT_SECONDS=25
# Database dedupe records for Bot messages are kept for this many days.
ZALO_BOT_PROCESSED_MESSAGE_RETENTION_DAYS=30

# OTP policy for viewing/editing an existing booking after the browser session is reset.
BOOKING_ACCESS_OTP_TTL_SECONDS=60
# Minimum time before the same booking/contact may receive another OTP.
BOOKING_ACCESS_OTP_RESEND_COOLDOWN_SECONDS=60
BOOKING_ACCESS_OTP_MAX_ATTEMPTS=2
BOOKING_ACCESS_OTP_RESEND_COOLDOWN_SECONDS=60

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=
AI_LOG_API_KEY=
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
