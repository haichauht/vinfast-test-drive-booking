# ==============================================================================
# VinFast Booking Agent - Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APP & NETWORK SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="AI20K Agent"
APP_ENV=development                       # Options: development, production, test
# Bật demo mô phỏng trên cả development và production; không bỏ qua OTP đặt lịch thật.
FLOATING_DEMO_ENABLED=true
APP_PORT=8000
APP_HOST=0.0.0.0
LOG_LEVEL=INFO                             # Options: DEBUG, INFO, WARNING, ERROR
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,https://c3-app-053.pages.dev,https://c3-portal-053.pages.dev
PUBLIC_SITE_URL=https://c3-app-053.pages.dev

# ------------------------------------------------------------------------------
# 2. LLM / AI CONFIGURATION
# ------------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key-here
MODEL_NAME=gpt-5.6-luna
CLASSIFIER_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_REASONING_EFFORT=low                   # Options: none, low, medium, high, xhigh, max
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# ------------------------------------------------------------------------------
# 3. DATABASE & STORAGE (PostgreSQL, Redis, Media CDN)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://vinfast:vinfast@localhost:5432/vinfast_booking
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0

# Seed Data (Loads 85-day dataset into empty database on startup)
AUTO_LOAD_EVAL_DATA=true
EVAL_DATA_DIR=eval/datav2/data-final-v2
BOOKING_ADVANCE_WINDOW_DAYS=30

# Media CDN for VinFast vehicle images
MEDIA_ROOT=./data/media
MEDIA_BASE_URL=https://pub-216eea433b9e4529979ce534d5ce0ae1.r2.dev

# ------------------------------------------------------------------------------
# 4. SECURITY & SESSION SECRETS (Required >= 32 characters in production)
# ------------------------------------------------------------------------------
BOOKING_ACCESS_OTP_SECRET=replace-with-at-least-32-random-characters
CONVERSATION_SIGNING_SECRET=replace-with-at-least-32-random-characters

# OTP Configuration
BOOKING_ACCESS_OTP_TTL_SECONDS=300         # 5 minutes validity
BOOKING_ACCESS_OTP_RESEND_COOLDOWN_SECONDS=60
BOOKING_ACCESS_OTP_MAX_ATTEMPTS=3
INTERNAL_SESSION_TTL_SECONDS=28800         # 8 hours for staff/admin sessions

# ------------------------------------------------------------------------------
# 5. GUARDRAILS & RATE LIMITING
# ------------------------------------------------------------------------------
GUARDRAILS_ENABLED=true
RATE_LIMIT_ENABLED=true
LLM_DAILY_BUDGET_ENABLED=true
LLM_DAILY_MAX_COST_USD=20.0
LLM_SESSION_MAX_COST_USD_PER_DAY=1.0

# ------------------------------------------------------------------------------
# 6. OPTIONAL INTEGRATIONS (Gmail Notification & Zalo Bot)
# ------------------------------------------------------------------------------
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_SENDER_EMAIL=""
GMAIL_SENDER_NAME="VinFast"

ZALO_BOT_ENABLED=false
ZALO_BOT_TOKEN=""
ZALO_BOT_API_BASE_URL="https://bot-api.zaloplatforms.com"
