# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# LLM Models Configuration
MODEL_NAME=openai/gpt-4o-mini
CLASSIFIER_MODEL_NAME=google/gemini-2.0-flash-exp

# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database & Redis ----
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
REDIS_ENABLED=true
REDIS_URL=redis://ur_url
# For SQLite (development):
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_ENV=development
APP_PORT=8000
# Host port published by Docker Compose (container still listens on APP_PORT=8000)
BACKEND_HOST_PORT=8001
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173
INTERNAL_SESSION_TTL_SECONDS=28800

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Deterministic AI Guardrails ----
# Keep enabled outside isolated local debugging. The limits protect the prompt,
# tool executor and public response without making an extra LLM call.
GUARDRAILS_ENABLED=true
GUARDRAILS_MAX_PAYLOAD_BYTES=16384
GUARDRAILS_MAX_PAYLOAD_DEPTH=6
GUARDRAILS_MAX_PAYLOAD_NODES=256
GUARDRAILS_MAX_PAYLOAD_STRING_CHARS=5000
GUARDRAILS_MAX_TOOL_CALLS_PER_MESSAGE=3
GUARDRAILS_MAX_OUTPUT_CHARS=8000

# ---- Public Rate Limits ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_ANON_COOKIE_NAME=anon_session_id
RATE_LIMIT_ANON_COOKIE_TTL_SECONDS=2592000
RATE_LIMIT_CHAT_PER_SESSION_PER_MINUTE=10
RATE_LIMIT_CHAT_PER_SESSION_PER_HOUR=120
RATE_LIMIT_CHAT_PER_IP_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_IP_PER_HOUR=600
RATE_LIMIT_DEMO_ACTION_PER_SESSION_PER_MINUTE=30
RATE_LIMIT_DEMO_ACTION_PER_SESSION_PER_HOUR=300
RATE_LIMIT_DEMO_ACTION_PER_IP_PER_MINUTE=120
RATE_LIMIT_DEMO_ACTION_PER_IP_PER_HOUR=1200
RATE_LIMIT_OTP_REQUEST_PER_CONTACT_PER_HOUR=10
RATE_LIMIT_OTP_VERIFY_PER_CHALLENGE_PER_MINUTE=5

# ---- LLM Money Budget ----
LLM_DAILY_BUDGET_ENABLED=true
LLM_DAILY_MAX_COST_USD=20
LLM_SESSION_MAX_COST_USD_PER_DAY=1
LLM_MAX_CALLS_PER_TURN=8
LLM_ESTIMATED_INPUT_TOKEN_PRICE_PER_1M=0.15
LLM_ESTIMATED_OUTPUT_TOKEN_PRICE_PER_1M=0.60
LLM_ESTIMATED_OUTPUT_TOKENS_PER_CALL=700

# ---- Zalo Bot (booking access OTP) ----
# Keep these backend-only. Never expose them through Vite or NEXT_PUBLIC_* variables.
# BOT_TOKEN is issued by Zalo Bot Creator and is used for sendMessage calls.
ZALO_BOT_TOKEN=your-zalo-bot-token-here
# Must exactly match the secret_token configured while registering the Zalo webhook.
ZALO_BOT_WEBHOOK_SECRET=replace-with-a-long-random-secret
ZALO_BOT_API_BASE_URL=https://bot-api.zaloplatforms.com
# Enable only after the webhook and the Zalo identity-link flow are deployed.
ZALO_BOT_ENABLED=false
# Local/demo only: continuously reads Bot messages with getUpdates. Do not enable
# together with a configured Zalo webhook.
ZALO_BOT_POLLING_ENABLED=false
ZALO_BOT_POLL_TIMEOUT_SECONDS=25
# Database dedupe records for Bot messages are kept for this many days.
ZALO_BOT_PROCESSED_MESSAGE_RETENTION_DAYS=30

# OTP policy for viewing/editing an existing booking after the browser session is reset.
BOOKING_ACCESS_OTP_TTL_SECONDS=60
# Minimum time before the same booking/contact may receive another OTP.
BOOKING_ACCESS_OTP_RESEND_COOLDOWN_SECONDS=60
BOOKING_ACCESS_OTP_MAX_ATTEMPTS=2
# Required in production: a server-only random secret used when hashing OTPs.
# Generate once with: openssl rand -hex 32
BOOKING_ACCESS_OTP_SECRET=
# Local development only. Production always suppresses mock OTP values.
BOOKING_ACCESS_EXPOSE_MOCK_OTP=true

# ---- Gmail Email Notifications ----
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=VinFast
GMAIL_TIMEOUT_SECONDS=15
NOTIFICATION_POLL_INTERVAL_SECONDS=60
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=300

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=
AI_LOG_API_KEY=ur_key
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000
